# ==========================================
# XHIRE BACKEND CONFIGURATION
# ==========================================

# Database Configuration
# For PostgreSQL:
# DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database_name>
# Example (Neon/Supabase):
# DATABASE_URL=postgresql://user:pass@ep-cool-frost-123456.us-east-2.aws.neon.tech/xhire?sslmode=require
# Fallback to local SQLite if unset:
DATABASE_URL=sqlite:///./Xhire.db

# Celery & Redis Broker Configuration
# For Redis on localhost or cloud (e.g. Upstash):
# BROKER_URL=redis://localhost:6379/0
# RESULT_BACKEND=redis://localhost:6379/0
# Example (Upstash Redis):
# BROKER_URL=rediss://default:<password>@<host>.upstash.io:6379/0
# RESULT_BACKEND=rediss://default:<password>@<host>.upstash.io:6379/0

# LLM & AI Engine Configuration
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=not-needed

# Frontend URL
FRONTEND_URL=http://localhost:3000
